{
  "name": "modelbridge-workspace",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/modelbridge", "packages/runtime"],
  "scripts": {
    "dev": "bun run --cwd apps/modelbridge dev",
    "build": "bun run --cwd apps/modelbridge build",
    "lint": "eslint --cache .",
    "lint:all": "bun run lint && bun run --cwd packages/runtime lint && bun run --cwd apps/modelbridge lint",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "bun run typecheck && bun run --cwd packages/runtime typecheck && bun run --cwd apps/modelbridge typecheck",
    "test": "bun test ./tests && bun run --cwd packages/runtime test && bun run --cwd apps/modelbridge test",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*": "bun run lint --fix",
    "packages/runtime/**/*": "eslint --config packages/runtime/eslint.config.mjs --cache --fix",
    "apps/modelbridge/**/*": "eslint --config apps/modelbridge/eslint.config.mjs --cache --fix"
  },
  "trustedDependencies": ["electron"],
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/bun": "1.3.14",
    "@types/node": "24.6.2",
    "eslint": "^9.37.0",
    "eslint-config-flat-gitignore": "^2.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^16.3.0",
    "lint-staged": "^16.2.3",
    "prettier": "3.6.2",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.45.0"
  },
  "engines": { "node": ">=22.18.0" }
}
